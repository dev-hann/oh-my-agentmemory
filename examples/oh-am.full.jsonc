// oh-my-agentmemory — full configuration reference.
//
// Place at: ~/.config/opencode/oh-am.jsonc
//
// All fields are optional. Built-in defaults shown for each.
// Env vars (when set) take precedence over this file.
//
// Precedence per field:
//   process env var > this file > built-in default
{
  // ─── agentmemory server connection ─────────────────────────────────
  //
  // Defaults to AGENTMEMORY_URL env var, then "http://localhost:3111".
  "url": "http://localhost:3111",

  // Bearer token, required only if the server enables auth.
  // Env AGENTMEMORY_SECRET wins.
  "secret": "",

  // ─── operating mode ────────────────────────────────────────────────
  //
  // "auto"      — probe agentmemory on session.created, decide full vs mcp-only
  // "full"      — assume capture.ts is loaded; never probe
  // "mcp-only"  — assume capture.ts NOT loaded; skip learning/archive hooks,
  //               enforcement directive strengthens to compensate
  //
  // Env OH_AM_MODE wins.
  "mode": "auto",

  // ─── hook toggles ──────────────────────────────────────────────────
  //
  // Phase ids to disable. Replaces OH_AM_DISABLE env.
  // Valid: "enforcement" | "init" | "intent" | "archive" | "learning"
  "disabled": [],

  // ─── bootstrap project map ─────────────────────────────────────────
  //
  // Extend the built-in PROJECT_MAP in src/core/bootstrap.ts.
  // User entries are always prepended (checked first); built-ins are the
  // fallback. Each entry is matched against the cwd at session.created;
  // the first match wins.
  "projectMap": [
    {
      "match": "my-cool-app",        // RegExp source, matched against cwd
      "projectId": "mca",            // stable identifier used in slot text
      "displayName": "My Cool App",  // human-readable
      "stack": ["Go", "Postgres", "gRPC"]  // optional hints
    },
    {
      "match": "data-pipeline",
      "projectId": "data-pipeline",
      "displayName": "Data Pipeline Service",
      "stack": ["Python", "Airflow", "Snowflake"]
    }
  ],

  // ─── health check ──────────────────────────────────────────────────
  //
  // On plugin init, GET /agentmemory/health.
  "healthCheckOnBoot": true,        // ping server at startup
  "healthCheckTimeoutMs": 2000,     // abort after N ms
  "healthCheckFatal": false,        // if true, plugin self-disables on failure

  // ─── debug ─────────────────────────────────────────────────────────
  //
  // Verbose stderr logging. OH_AM_DEBUG=1 env wins.
  "debug": false
}
